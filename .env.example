# ComplianceRadar-Scanner Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AWS Bedrock Configuration (Used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# OpenAI-Compatible Configuration (Used when LLM_PROVIDER=openai_compatible)
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Background Scheduler & Compliance IQ Webhook Integration
SCAN_INTERVAL_MINUTES=360
ACTIVE_JURISDICTIONS=UAE,KSA
COMPLIANCE_IQ_WEBHOOK_URL=http://localhost:8080/api/v1/compliance-iq/mock-receiver
COMPLIANCE_IQ_API_SECRET=complianceradar-dev-secret
PORT=8080
